# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Application URLs & Config
CLIENT_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
TRUST_PROXY=true

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=your-email@example.com
FROM_EMAIL=your-verified-sender@example.com
OWNER_EMAIL=your-email@example.com

# Google AdSense Monetization (Format: pub-XXXXXXXXXXXXXXXX or ca-pub-XXXXXXXXXXXXXXXX)
# Obtain from your Google AdSense console under Account -> Settings -> Account information
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Groq AI Service Configuration (Server-Only — Never prefix with NEXT_PUBLIC_)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARY_MODEL=llama-3.1-8b-instant

# Vercel Blob Storage Configuration (Server-Only — Never prefix with NEXT_PUBLIC_)
# Automatically populated by Vercel when connecting a Blob Store in Vercel Dashboard (Storage -> Blob -> Create Store)
# Or manually configured under Vercel Project Settings -> Environment Variables
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
